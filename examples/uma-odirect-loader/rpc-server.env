# Remote RPC server settings for the UMA O_DIRECT stream extension.

# Enable the stream extension explicitly. Keep the RPC server on a trusted
# private network; it is not an authenticated public service.
GGML_RPC_ODIRECT_STREAM_ENABLE=1

# Required for SET_TENSOR_FROM_FILE stream mode. Keep both values narrow.
GGML_RPC_ODIRECT_STREAM_ALLOW_ENDPOINT=10.0.0.1:50152
GGML_RPC_ODIRECT_STREAM_PATH_PREFIX=/models/

# Example:
#   set -a
#   . examples/uma-odirect-loader/rpc-server.env
#   set +a
#   ./build/bin/rpc-server -H 0.0.0.0 -p 50052
