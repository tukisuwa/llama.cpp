# Main llama-server settings for a quieter UMA-safe RPC load.

MODEL=/models/model.gguf
RPC_ENDPOINT=10.0.0.2:50052
TENSOR_SPLIT=1,1

GGML_RPC_ODIRECT_STREAM_ENDPOINT=local
GGML_RPC_ODIRECT_STREAM_MODE=local
GGML_LOCAL_ODIRECT_STREAM_ENDPOINT=local
GGML_LOCAL_ODIRECT_STREAM_MODE=local

# Shared weighted read budget. This is usually less aggressive than the
# independent fast profile and can reduce local IO PSI during load.
GGML_ODIRECT_READ_SCHEDULER=weighted
GGML_ODIRECT_READ_RATE_LIMIT_MIBPS=3600
GGML_RPC_ODIRECT_READ_WEIGHT=1
GGML_LOCAL_ODIRECT_READ_WEIGHT=1

UMA_BUFFER_LOAD_ORDER=remote-first
UMA_BUFFER_GATE=30
UMA_BUFFER_MIN_AVAILABLE_GIB=20
UMA_SLICE_MIB=1024
UMA_PSI_GATE=30
UMA_MIN_AVAILABLE_GIB=20
