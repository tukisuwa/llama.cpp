# Main llama-server settings for a fast UMA-safe RPC load.

MODEL=/models/model.gguf
RPC_ENDPOINT=10.0.0.2:50052
TENSOR_SPLIT=1,1

# Read model bytes locally on the main node and stream tensor payloads to RPC.
GGML_RPC_ODIRECT_STREAM_ENDPOINT=local
GGML_RPC_ODIRECT_STREAM_MODE=local

# Use in-process local O_DIRECT reads for local tensors as well.
GGML_LOCAL_ODIRECT_STREAM_ENDPOINT=local
GGML_LOCAL_ODIRECT_STREAM_MODE=local

# Tune independently: no RPC limit, local direct read capped.
GGML_ODIRECT_READ_SCHEDULER=none
GGML_RPC_ODIRECT_READ_RATE_LIMIT_MIBPS=0
GGML_LOCAL_ODIRECT_READ_RATE_LIMIT_MIBPS=3000

# Suggested llama-server args.
UMA_BUFFER_LOAD_ORDER=remote-first
UMA_BUFFER_GATE=30
UMA_BUFFER_MIN_AVAILABLE_GIB=20
UMA_SLICE_MIB=1024
UMA_PSI_GATE=30
UMA_MIN_AVAILABLE_GIB=20
